{
  "name": "gloom-watch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted single-user PWA tracking a masterset of the Pokemon Oddish line",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "preinstall": "bun run scripts/check-bun-version.ts",
    "check:bun": "bun run scripts/check-bun-version.ts",
    "dev": "vite",
    "dev:server": "bun --watch server/index.ts",
    "build": "vite build",
    "start": "bun server/index.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:check": "bun --bun drizzle-kit check",
    "db:migrate": "bun server/db/migrate.ts",
    "cron:register": "bun server/jobs/register-cron.ts",
    "vapid:generate": "bun scripts/generate-vapid-keys.ts",
    "push:test": "bun scripts/send-test-push.ts",
    "corpus:sync": "bun server/jobs/corpus-sync.ts",
    "icons": "bun scripts/generate-icons.ts",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "bun run check:bun && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.132.66",
    "@tanstack/react-virtual": "^3.14.9",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.0.4",
    "vitest": "^3.2.4",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.3.0"
  }
}
