# Gloom Watch environment.
#
# On the deployment box this file lives at /etc/gloom-watch/gloom-watch.env, owned by root and
# readable by the gloom group, and is read by systemd before it drops to the service account. It
# is never committed; this example carries the key names and empty values only.
#
#   sudo install -D -o root -g gloom -m 0640 .env.example /etc/gloom-watch/gloom-watch.env
#
# The mode is 0640 rather than 0600, and the group matters. A scheduled Bun.cron job runs as
# `gloom` outside systemd and inherits nothing from EnvironmentFile, so it has to read this file
# itself — see server/env-file.ts. Root-only 0600 would make that impossible and VAPID_PRIVATE_KEY
# would be absent in exactly the process that needs it, silently. Group-read by the one account
# that already runs the application is the smallest change that lets both halves work.
#
# `VACUUM INTO` cannot capture this file — it copies a SQLite database and these live outside
# it. The backup job must archive this file alongside the snapshot, or a restore silently omits
# VAPID_PRIVATE_KEY and destroys every subscription. RELIST_HASH_SALT has the same property:
# lose it and the relist guard stops matching after a restore.

# ---------------------------------------------------------------------------
# Runtime — the walking skeleton reads these. Every one has a working default.
# ---------------------------------------------------------------------------

# SQLite file. Keep it under data/ — .gitignore excludes data/, photos/, backups/ and *.db*,
# and this repository is public.
GLOOM_WATCH_DB=data/gloom-watch.db

# Built client assets, served by Hono. Relative paths resolve from the working directory.
GLOOM_WATCH_CLIENT_DIR=dist/client

# Generated Drizzle migrations.
GLOOM_WATCH_MIGRATIONS_DIR=drizzle

# IANA timezone name, applied on first boot only. Afterwards the database is authoritative and
# this value is ignored. Digest times and cron schedules are interpreted in it.
GLOOM_WATCH_TIMEZONE=

# Tailscale Serve proxies to loopback, so there is no reason to bind anything wider.
HOST=127.0.0.1
PORT=3000

# The origin the phone reaches the app on — the Tailscale Serve hostname, with the scheme:
#
#   GLOOM_WATCH_ORIGIN=https://htpc.tail594f35.ts.net
#
# A push notification's tap target is an absolute same-origin URL, and the process that builds it
# may be a cron job with no request to read a Host header from. Left unset it falls back to
# http://HOST:PORT, which is a loopback address the phone cannot reach, and `bun run push:test`
# refuses to send rather than spend a notification on a tap that opens nothing.
GLOOM_WATCH_ORIGIN=

# Where a process that did not inherit systemd's EnvironmentFile should go looking for it.
# Defaults to /etc/gloom-watch/gloom-watch.env; set it only to move that file.
GLOOM_WATCH_ENV_FILE=

# ---------------------------------------------------------------------------
# Web Push. Generate the keypair ONCE with `bun run vapid:generate`, then copy
# both halves here. VAPID_SUBJECT is a mailto: or https: URL and is required in
# the JWT.
#
# Rotating this keypair returns 400 VapidPkHashMismatch on the next send and
# invalidates every subscription for the origin; recovery needs a tap on the
# device. The backup job must archive this file alongside the database snapshot,
# because a restore without VAPID_PRIVATE_KEY does exactly that.
# ---------------------------------------------------------------------------

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# eBay Browse API — later tickets. OAuth client credentials; no user consent,
# no refresh token.
# ---------------------------------------------------------------------------

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# HMAC-SHA-256 key for the relist seller hash. Named in the spec so fixtures are portable and
# the value is stable across a restore. Never displayed, never reversible.
RELIST_HASH_SALT=

# ---------------------------------------------------------------------------
# Backup — later tickets. restic against both destinations, because age encrypts
# each file under a fresh ephemeral key and two encryptions of a 125 MB database
# dedupe to nothing.
# ---------------------------------------------------------------------------

# The repository password. An automated backup needs its credentials on the box, so the box can
# read its own backups; the write-only property a public-key-only recipient would give is not
# achievable alongside deduplication. Keep a copy off-box in a password manager — that copy is
# disaster recovery, not access control. Use a password used nowhere else.
BACKUP_RESTIC_PASSWORD=

# Retained from the spec's secrets list. age is not the chosen mechanism; restic is.
BACKUP_AGE_RECIPIENT=

BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
